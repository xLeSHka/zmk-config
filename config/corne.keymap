#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        hold: hold {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "bas";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R             &kp T        &kp Y      &kp U          &kp I      &kp O    &kp P     &kp EQUAL
&kp TAB    &kp A  &kp S  &kp D  &kp F             &kp G        &kp H      &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp SLASH  &kp Z  &kp X  &kp C  &kp V             &kp B        &kp N      &kp M          &kp COMMA  &kp DOT  &kp LPAR  &kp MINUS
                         &mo 1  &kp LEFT_BRACKET  &kp SPACE    &kp ENTER  &kp BACKSPACE  &mo 2
            >;
        };

        lower {
            display-name = "low";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE      &kp EXCLAMATION   &kp AT_SIGN    &kp POUND         &kp DLLR        &kp PERCENT    &kp CARET         &kp AMPERSAND      &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&kp TILDE      &sk LEFT_CONTROL  &sk LEFT_GUI   &sk LEFT_ALT      &sk LEFT_SHIFT  &kp PLUS       &kp EQUAL         &kp LEFT_BRACE     &kp RIGHT_BRACE  &kp UNDERSCORE        &kp SEMI               &kp SQT
&kp BACKSLASH  &kp PIPE          &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION    &kp COLON      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp COMMA        &kp COMMA             &kp DOT                &kp FSLH
                                                &trans            &mo 4           &trans         &trans            &kp DOUBLE_QUOTES  &mo 3
            >;
        };

        raise {
            display-name = "rai";
            bindings = <
&trans  &trans  &kp PG_UP  &kp UP    &kp PAGE_DOWN  &kp END    &trans  &trans           &trans         &trans         &trans             &trans
&trans  &trans  &kp LEFT   &kp DOWN  &kp RIGHT      &kp END    &trans  &sk RIGHT_SHIFT  &sk RIGHT_ALT  &sk RIGHT_GUI  &sk RIGHT_CONTROL  &trans
&trans  &trans  &trans     &trans    &trans         &trans     &trans  &trans           &trans         &trans         &trans             &trans
                           &mo 3     &trans         &trans     &trans  &trans           &trans
            >;
        };

        fbut {
            display-name = "fbu";
            bindings = <
&trans  &trans     &kp F10   &kp F11   &kp F12    &trans    &kp N1  &kp N2  &kp N3  &kp F1  &kp F2  &kp F3
&trans  &sk LCTRL  &sk LGUI  &sk LALT  &sk LSHFT  &trans    &kp N4  &kp N5  &kp N6  &kp F4  &kp F5  &kp F6
&trans  &trans     &trans    &trans    &trans     &trans    &kp N7  &kp N8  &kp N9  &kp F7  &kp F8  &kp F9
                             &trans    &trans     &trans    &trans  &trans  &trans
            >;
        };

        adjust {
            display-name = "adj";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&bootloader        &sys_reset       &out OUT_TOG     &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &trans             &trans           &trans           &trans           &trans           &trans  &trans
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &trans           &trans           &trans           &trans           &trans  &trans
&ext_power EP_TOG  &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD    &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &trans  &trans
                                                     &trans           &trans           &trans             &trans           &trans           &trans
            >;
        };
    };
};
