#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    combos {
        compatible = "zmk,combos";

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <12 0>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <24 12>;
        };

        plus {
            bindings = <&kp KP_PLUS>;
            key-positions = <2 3>;
        };

        minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <3 4>;
        };

        lparenthes {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 5>;
        };

        quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <15 16>;
        };

        squote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <19 20>;
        };

        lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 17>;
        };

        lbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <28 29>;
        };

        rparenthes {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        rbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        rbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <30 31>;
        };

        under {
            bindings = <&kp UNDER>;
            key-positions = <7 8>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <8 9>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <31 32>;
        };
    };

    behaviors {
        hold: hold {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R  &kp T                     &kp Y         &kp U          &kp I        &kp O    &kp P      &lt 3 LA(SPACE)
&kp TAB    &kp A  &kp S  &kp D     &kp F  &kp G                     &kp H         &kp J          &kp K        &kp L    &kp SEMI   &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B                     &kp N         &kp M          &kp COMMA    &kp DOT  &kp SLASH  &kp RIGHT_BRACKET
                         &kp LGUI  &mo 1  &mt LEFT_COMMAND SPACE    &kp LEFT_ALT  &kp BACKSPACE  &lt 2 ENTER
            >;
        };

        lower {
            display-name = "low";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TILDE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5        &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8     &kp NUMBER_9          &kp NUMBER_0           &kp BSPC
&kp GRAVE  &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PERCENT         &kp CARET     &kp AMPS      &kp STAR         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE
&kp LSHFT  &trans        &trans        &trans        &trans        &kp LA(SPACE)       &kp UNDER     &kp PLUS      &kp LBRC         &kp RBRC              &kp PIPE               &kp TILDE
                                       &mo 4         &trans        &kp LEFT_COMMAND    &kp KP_COMMA  &kp KP_DOT    &kp LS(KP_PLUS)
            >;
        };

        raise {
            bindings = <
&trans  &trans  &kp PG_UP  &kp UP    &kp PG_DN  &kp HOME    &kp CARET  &kp PG_UP  &kp UP    &kp PG_DN  &kp HOME  &trans
&trans  &trans  &kp LEFT   &kp DOWN  &kp RIGHT  &kp END     &kp MINUS  &kp LEFT   &kp DOWN  &kp RIGHT  &kp END   &trans
&trans  &trans  &trans     &trans    &trans     &trans      &trans     &trans     &trans    &trans     &trans    &trans
                           &trans    &trans     &trans      &trans     &trans     &trans
            >;
        };

        fbut {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6     &trans  &kp LEFT_GUI  &kp LALT  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12    &trans  &trans        &trans    &trans          &trans            &trans
&trans  &trans  &trans  &trans   &trans   &trans     &trans  &trans        &trans    &trans          &trans            &trans
                        &trans   &trans   &trans     &trans  &trans        &trans
            >;
        };

        adjust {
            display-name = "adj";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&bootloader        &sys_reset       &out OUT_TOG     &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &kp N5             &kp N6           &kp N7           &kp N8           &kp N9           &kp N0  &kp BSPC
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &trans  &trans
&ext_power EP_TOG  &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD    &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &trans  &trans
                                                     &kp LGUI         &trans           &kp SPACE          &kp RET          &trans           &kp RALT
            >;
        };
    };
};
